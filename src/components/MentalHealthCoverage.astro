---
const rows = [
  {
    who: "Psychiatrists and family doctors",
    covered: true,
    note: "Usually covered by OHIP when you have a valid health card. Wait times can be long, and a referral to a psychiatrist is often needed.",
  },
  {
    who: "Psychologists and private therapists",
    covered: false,
    note: "Usually not covered by OHIP. Covered partly through workplace or school benefits, private insurance, or a free public program instead.",
  },
  {
    who: "Publicly funded clinics, hospitals, and community agencies",
    covered: true,
    note: "Often free, including some therapy and counselling, but can have a waitlist. ConnexOntario can help you find one near you.",
  },
];
---
<section class="coverage">
  <div class="inner">
    <h2>Does OHIP cover therapy?</h2>
    <p class="hint">It depends who you see and where. Here's the short version.</p>

    <div class="coverage-grid">
      {rows.map((r) => (
        <div class="coverage-card">
          <span class:list={["badge", { yes: r.covered, no: !r.covered }]}>
            {r.covered ? "Usually covered" : "Usually not covered"}
          </span>
          <h3>{r.who}</h3>
          <p>{r.note}</p>
        </div>
      ))}
    </div>

    <p class="footer-note">No insurance and don't want to wait? The <a href="/navigate-care/mental-health/free-therapy">Ontario Structured Psychotherapy Program</a> offers free, short-term CBT with no referral needed.</p>
  </div>
</section>

<style>
  .coverage { padding: 72px 24px; }
  .inner { max-width: 1120px; margin: 0 auto; }
  h2 { font-size: 34px; margin: 0 0 8px; }
  .hint { opacity: 0.75; margin: 0 0 28px; }

  .coverage-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .coverage-card { background: white; border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .badge {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; padding: 5px 12px; border-radius: 999px; margin-bottom: 14px;
  }
  .badge.yes { background: rgba(47, 143, 91, 0.12); color: var(--green); }
  .badge.no { background: rgba(15, 36, 56, 0.08); color: var(--navy); }
  .coverage-card h3 { font-size: 18px; margin: 0 0 10px; }
  .coverage-card p { font-size: 14.5px; opacity: 0.8; line-height: 1.6; margin: 0; }

  .footer-note { font-size: 15px; margin: 28px 0 0; }
  .footer-note a { color: var(--teal); }

  @media (max-width: 860px) {
    .coverage-grid { grid-template-columns: 1fr; }
    h2 { font-size: 28px; }
  }
</style>
